# Copiá este archivo a ".env" (que ya está en .gitignore) y completá las keys que tengas.
# Anzuelo funciona sin ninguna de las dos: simplemente omite esa fuente de Threat Intelligence
# y lo deja marcado como "no configurada" en los resultados.

# VirusTotal (gratuita, ~4 req/min): https://www.virustotal.com/gui/join-us
VIRUSTOTAL_API_KEY=

# AbuseIPDB (gratuita, 1000 req/día): https://www.abuseipdb.com/register
ABUSEIPDB_API_KEY=

# abuse.ch (URLhaus) — desde 2025 requiere un Auth-Key gratuito, registrate en
# https://auth.abuse.ch/ (misma cuenta sirve para URLhaus, ThreatFox, MalwareBazaar)
ABUSECH_AUTH_KEY=

# Geolocalización de la IP de origen del correo (ip-api.com) — gratuita,
# SIN API key, no requiere configurar nada acá. Se incluye solo para que
# quede documentado en el README/health check que esta fuente no tiene costo
# ni límite de configuración, a diferencia de HIBP_API_KEY abajo.

# HaveIBeenPwned (brechas de datos conocidas para el email del remitente).
# A diferencia de las anteriores, ESTA NO ES GRATUITA: requiere una suscripción
# de pago desde ~USD 4.39/mes (plan "Core 1", alcanza de sobra para uso
# personal/homelab). Sacala en https://haveibeenpwned.com/API/Key — sin esta
# key, Anzuelo simplemente omite el chequeo de brechas y sigue funcionando
# igual con el resto de las fuentes.
HIBP_API_KEY=

# --- Autenticación (recomendado configurar si vas a usar esto más allá de pruebas) ---

# Secreto para firmar los JWT de sesión. Si lo dejás vacío, se genera uno
# aleatorio en cada arranque del backend — funciona, pero invalida todas las
# sesiones activas cada vez que reiniciás el proceso. Para algo persistente,
# generá uno propio, por ejemplo con: python -c "import secrets; print(secrets.token_hex(32))"
ANZUELO_JWT_SECRET=

# Minutos de validez de la sesión (JWT). Por defecto 480 (8hs) si se deja vacío.
ANZUELO_JWT_EXPIRE_MINUTES=480
